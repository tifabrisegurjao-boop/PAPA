{
    "manifest_version": 3,
    "name": "PAPA — Acesso ao SEI",
    "short_name": "PAPA SEI",
    "version": "0.1.1",
    "description": "A pedido do Projeto PAPA (Fabris & Gurjão): entra no SEI com a conta de acesso do processo e abre o processo na lista de acessos externos.",
    "minimum_chrome_version": "111",
    "icons": { "16": "icones/16.png", "32": "icones/32.png", "48": "icones/48.png", "128": "icones/128.png" },
    "action": { "default_title": "PAPA — contas de acesso ao SEI", "default_icon": { "16": "icones/16.png", "32": "icones/32.png" } },
    "options_ui": { "page": "opcoes.html", "open_in_tab": true },
    "background": { "service_worker": "fundo.js" },
    "permissions": ["storage"],
    "content_scripts": [
        {
            "matches": [
                "https://sei.sistemas.ro.gov.br/sei/*",
                "https://sei.dnit.gov.br/sei/*",
                "https://sei.incra.gov.br/sei/*",
                "https://sei.trf1.jus.br/sei/*",
                "https://sei.fiocruz.br/sei/*"
            ],
            "js": ["logica.js", "sei.js"],
            "run_at": "document_start",
            "all_frames": false
        },
        {
            "matches": ["https://papa-85025.web.app/*", "https://papa-85025.firebaseapp.com/*", "http://localhost:5173/*", "http://localhost:5174/*"],
            "js": ["papa.js"],
            "run_at": "document_start",
            "all_frames": false
        }
    ]
}
